  m_Script: {fileID: 11500000, guid: c255601cf659353458a1f11efbb6078b, type: 3}
  m_Name: Questions_Level_5
  m_EditorClassIdentifier: 
  questions:
  - questionText: "Tu nave aterriz\xF3 en un planeta con tres soles\nUno est\xE1
      a la izquierda, otro arriba y otro a la derecha\r\r\r \r\nSi el sol de la izquierda
      se apaga, \xBFde qu\xE9 lado viene la sombra?\r"
    options:
    - Izquierda
    - Derecha
    - Arriba
    - Abajo
    correctOptionIndex: 0
  - questionText: "Tres estaciones espaciales orbitan el mismo planeta en distintas
      alturas:\n-Estaci\xF3n A completa una \xF3rbita en 3 horas.\n-Estaci\xF3n B
      completa una \xF3rbita en 4 horas.\n-Estaci\xF3n C completa una \xF3rbita en
      6 horas.\nTodas est\xE1n alineadas (en la misma l\xEDnea radial) a las 00:00.\n\xBFDespu\xE9s
      de cu\xE1ntas horas volver\xE1n a alinearse las tres exactamente en la misma
      posici\xF3n?\r\n"
    options:
    - 6 horas
    - 12 horas
    - 24 horas
    - 36 horas
    correctOptionIndex: 1
  - questionText: "Tu panel de control muestra: 2, 4, 8, 16, __ \xBFQu\xE9 n\xFAmero
      sigue?"
    options:
    - 24
    - 32
    - 64
    - 18
    correctOptionIndex: 1
  - questionText: "La Luna cambia de forma durante el mes. \xBFC\xF3mo se llama cuando
      est\xE1 completamente iluminada?"
    options:
    - Luna nueva
    - Cuarto creciente
    - Luna llena
    - Luna menguante
    correctOptionIndex: 2
  - questionText: "Los alien\xEDgenas enviaron un mensaje cifrado con un Cifrado
      C\xE9sar (desplazamiento +1, cada letra original fue desplazada una posici\xF3n
      hacia adelante en el alfabeto):\n\nNBSUF \xBFCu\xE1l es la palabra original?"
    options:
    - TIERRA
    - VENUS
    - MARTE
    - COMETA
    correctOptionIndex: 2
